@startuml sequence-plan-and-save
!include _style.iuml
hide footbox
skinparam maxMessageSize 170

actor Traveller as T
participant "PlanTripPage" as P
participant "apiClient" as A
participant "plannerController" as PC
participant "itineraryService" as IS
participant "RouteProvider" as RP
participant "budgetService" as BS
participant "tripController /\ntripService" as TS
database "MongoDB" as DB

== Generate plan preview (public) ==
T -> P : submit plan form
P -> A : previewPlan(planInput)
A -> PC : POST /api/v1/planner/preview
PC -> PC : validate(planInput) [Zod]
PC -> DB : find destination + activities
DB --> PC : destination, activities[]
PC -> IS : generateItinerary(activities, days,\npace, interests, startDate, routeProvider)
loop each day, each candidate stop
  IS -> RP : getLeg(from, to)
  alt Google key set and Distance Matrix answers within 4 s
    RP -> RP : call Distance Matrix API
    RP --> IS : { km, minutes }
  else no key, timeout or upstream error
    RP -> RP : local fallback: haversine x 1.3,\n25 km/h; log warning
    RP --> IS : { km, minutes } (provider = local)
  end
end
IS --> PC : itinerary[ItineraryDay]
PC -> BS : estimateBudget(dailyCost, tier, days,\ntravelers, activityFeesPerPerson)
BS --> PC : budget
PC --> A : 200 { success, data, meta.provider }
A --> P : { destination, days, itinerary, budget }
P --> T : show itinerary + budget preview

== Save trip (JWT required) ==
T -> P : click "Save trip"
alt not logged in
  P -> P : sessionStorage stp.pendingPlan = planInput
  P --> T : redirect to /login
  T -> P : log in, return to /plan (preview restored)
end
P -> A : createTrip(planInput, title)
A -> TS : POST /api/v1/trips\nAuthorization: Bearer <jwt>
TS -> TS : auth middleware verifies JWT\n-> req.user
TS -> IS : regenerate itinerary (server side)
IS --> TS : itinerary
TS -> BS : estimateBudget(...)
BS --> TS : budget
TS -> DB : insert trip { user, destination,\nitinerary, budget, status: planned }
DB --> TS : trip
TS --> A : 201 { trip }
A --> P : trip
P --> T : navigate to /trips/:id (Trip Details)
@enduml
