NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://localhost:27017/smart_trip_planner
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origins allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173
# Reverse proxies in front of the API: 0 locally, 1 on Railway or Render
TRUST_PROXY=0
# local = seeded data, osm = OpenStreetMap + OSRM (free, no key), google = needs the key below
MAPS_PROVIDER=local
GOOGLE_MAPS_API_KEY=
