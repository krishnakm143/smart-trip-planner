# Environment mode: development, test, or production
NODE_ENV=development

# Server port (Railway / Render / Cloud platform automatically provides PORT)
PORT=4100

# Minimum 32-character JWT secret key for signing session tokens
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma-separated for multi-origin support, e.g., local + production)
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Set TRUST_PROXY=1 on Railway, Render, or any reverse-proxy deployment
TRUST_PROXY=1

# Maps & Places Provider: "google", "osm", or "local"
# When set to "google", Places API (New) handles live discovery, photos & places lookup.
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Storage & Authentication Provider ("supabase" or "local" / "mongodb")
# Set both to "supabase" to persist trips and authentication in Supabase PostgreSQL
AUTH_PROVIDER=supabase
TRIP_STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MongoDB URI (used when TRIP_STORAGE=mongodb or local development fallback)
MONGODB_URI=mongodb://localhost:27017/smart_trip_planner

# Optional Groq AI Assistant (Llama-3.3-70B for interactive trip guidance)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Transactional Email Provider (Brevo) for passwordless OTP & trip emailing
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SENDER_EMAIL=notifications@smarttripplanner.com
BREVO_SENDER_NAME=Smart Trip Planner
