@startuml activity-auth
!include _style.iuml
|Visitor|
start
if (Has an account?) then (no)
  :Open /register, enter
  name, email, password;
  |React Client|
  :POST /auth/register;
  |Express API|
  :Rate limit + Zod validation
  (password >= 8 chars);
  if (Email already used?) then (yes)
    :409 CONFLICT;
    |React Client|
    :Show "email already registered";
    stop
  else (no)
  endif
  |Express API|
  :Hash password (bcrypt, cost 10);
  |MongoDB|
  :Insert user (role = traveler);
else (yes)
  |Visitor|
  :Open /login, enter
  email and password;
  |React Client|
  :POST /auth/login;
  |Express API|
  :Rate limit + Zod validation;
  |MongoDB|
  :Find user by email
  (+passwordHash);
  |Express API|
  if (Password matches hash?) then (no)
    :401 UNAUTHORIZED;
    |React Client|
    :Show "invalid email or password";
    stop
  else (yes)
  endif
endif
|Express API|
:Sign JWT (expires in 7 d);
:Return { user, token };
|React Client|
:Store token in localStorage,
set AuthContext user;
:Redirect to state.from
(or /trips);
|Visitor|
:Use protected pages;
stop
@enduml
