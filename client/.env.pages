# Settings for the build published on GitHub Pages: `npm run build:pages`.
VITE_BASE_PATH=/smart-trip-planner/

# The hosted API (Express + MongoDB on Railway).
VITE_API_URL=https://api-production-e3831.up.railway.app/api/v1

# Without a hosted API the site can answer requests in the browser instead:
# remove VITE_API_URL and set the two lines below (see src/browser-api).
# VITE_DATA_MODE=browser
# VITE_MAPS_PROVIDER=osm
