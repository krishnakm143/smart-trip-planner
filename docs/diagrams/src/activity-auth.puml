@startuml activity-auth
!include _style.iuml
|Visitor|
start
:Open /register (name, email,
password) or /login (email,
password) and submit;
|React Client|
:POST /auth/register
or POST /auth/login;
|Express API|
:Rate limit (20 req / 15 min / IP),
Zod validation (password >= 8 chars);
if (Request?) then (register)
  if (Email already used?) then (yes)
    :409 CONFLICT, client
    shows "email already
    registered";
    stop
  else (no)
  endif
  :Hash password
(bcrypt, cost 10);
  |MongoDB|
  :Insert user
  (role = traveler);
else (login)
  |MongoDB|
  :Find user by email
  (+passwordHash);
  |Express API|
  if (User found and password\nmatches hash?) then (no)
    :401 UNAUTHORIZED, client
    shows "invalid email
    or password";
    stop
  else (yes)
  endif
endif
|Express API|
:Sign JWT (expires in 7 d),
return { user, token };
|React Client|
:Store token in localStorage,
set AuthContext user;
:Redirect to state.from
(default /trips);
|Visitor|
:Use protected pages
(My Trips, Trip Details,
Save trip);
stop
@enduml
