@startuml class-diagram-services
!include _style.iuml
hide circle
hide empty members
skinparam nodesep 30
skinparam ranksep 50

class AuthService <<service>> {
  +register(name, email, password) : {user, token}
  +login(email, password) : {user, token}
  +getCurrentUser(userId) : User
  -signToken(user) : String
}
class TripService <<service>> {
  +buildPlan(planInput) : {destination, days, itinerary, budget}
  +createTrip(userId, planInput, title) : Trip
  +listTrips(userId, status) : TripSummary[]
  +getTrip(userId, tripId) : Trip
  +updateTrip(userId, tripId, patch) : Trip
  +deleteTrip(userId, tripId) : ObjectId
}
class DestinationService <<service>> {
  +list(search, category, page, limit) : {items, total, page, limit}
  +getBySlug(slug) : {destination, activities}
  +discover(slug, type) : {items, provider}
}
class ItineraryService <<service>> {
  +generateItinerary(activities, days, pace,
    interests, startDate, routeProvider) : ItineraryDay[]
  -scoreActivity(activity, interests) : Number
  -buildDay(pool, hoursPerDay) : ItineraryItem[]
  -scheduleDay(items, date) : ItineraryDay
}
class BudgetService <<service>> {
  +estimateBudget(dailyCost, tier, days,
    travelers, activityFeesPerPerson) : Budget
}

interface RouteProvider <<interface>> {
  +getLeg(from : GeoPoint, to : GeoPoint) : {km, minutes}
}
interface PlacesProvider <<interface>> {
  +discover(destination, type) : DiscoveredPlace[]
}
class LocalRouteProvider {
  -ROAD_FACTOR : Number = 1.3
  -AVG_SPEED_KMH : Number = 25
  +getLeg(from, to) : {km, minutes}
}
class GoogleRouteProvider {
  -apiKey : String
  -timeoutMs : Number = 4000
  +getLeg(from, to) : {km, minutes}
}
class LocalPlacesProvider {
  +discover(destination, type) : DiscoveredPlace[]
}
class GooglePlacesProvider {
  -apiKey : String
  -timeoutMs : Number = 4000
  +discover(destination, type) : DiscoveredPlace[]
}

TripService ..> ItineraryService : <<use>>
TripService ..> BudgetService : <<use>>
ItineraryService ..> RouteProvider : <<use>>
DestinationService ..> PlacesProvider : <<use>>
AuthService -[hidden]right- TripService

RouteProvider <|.. LocalRouteProvider
RouteProvider <|.. GoogleRouteProvider
PlacesProvider <|.. LocalPlacesProvider
PlacesProvider <|.. GooglePlacesProvider
GoogleRouteProvider -right-> LocalRouteProvider : fallback
GooglePlacesProvider -right-> LocalPlacesProvider : fallback

note bottom of AuthService
  Services operate on the Mongoose models
  User, Destination, Activity and Trip
  shown in the domain class diagram.
end note
@enduml
