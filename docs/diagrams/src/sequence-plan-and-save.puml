@startuml sequence-plan-and-save
!include _style.iuml
hide footbox
skinparam maxMessageSize 300
actor Traveller as T
participant "PlanTrip\nPage" as P
participant "apiClient" as A
participant "planner\nController" as PC
participant "itinerary\nService" as IS
participant "Route\nProvider" as RP
participant "budget\nService" as BS
participant "tripController /\ntripService" as TS
database "MongoDB" as DB

== Generate plan preview (public) ==
T -> P : submit plan form
P -> A : previewPlan(planInput)
A -> PC : POST /api/v1/\nplanner/preview
PC -> PC : validate(planInput)\n[Zod]
PC -> DB : find destination + activities
DB --> PC : destination, activities[]
PC -> IS : generateItinerary(\nactivities, days, pace,\ninterests, startDate,\nrouteProvider)
loop each day, each candidate stop
  IS -> RP : getLeg(from, to)
  alt remote provider configured, reply < 4 s
    RP -> RP : call OSRM table service\nor Google Distance Matrix
    RP --> IS : { km, minutes }
  else local provider / timeout / error
    RP -> RP : local fallback:\nhaversine x 1.3,\n25 km/h; log warning
    RP --> IS : { km, minutes }\n(provider = local)
  end
end
IS --> PC : ItineraryDay[]
PC -> BS : estimateBudget(dailyCost, tier, days,\ntravelers, activityFeesPerPerson)
BS --> PC : budget
PC --> A : 200 { success, data,\nmeta.provider }
A --> P : { destination, days,\nitinerary, budget }
P --> T : show itinerary +\nbudget preview

== Save trip (JWT required) ==
T -> P : click "Save trip"
opt traveller not logged in
  P -> P : sessionStorage\nstp.pendingPlan = planInput
  P --> T : redirect to /login
  T -> P : log in, return to /plan\n(preview restored)
end
P -> A : createTrip(planInput, title)
A -> TS : POST /api/v1/trips\nAuthorization: Bearer <jwt>
TS -> TS : auth middleware\nverifies JWT -> req.user
TS -> DB : find destination + activities
DB --> TS : destination, activities[]
TS -> IS : regenerate itinerary\n(server side)
IS --> TS : ItineraryDay[]
TS -> BS : estimateBudget(...)
BS --> TS : budget
TS -> DB : insert trip { user, destination,\nitinerary, budget, status: planned }
DB --> TS : trip
TS --> A : 201 { trip }
A --> P : trip
P --> T : navigate to /trips/:id\n(Trip Details)
@enduml
