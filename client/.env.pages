# Settings for the static build published on GitHub Pages: `npm run build:pages`.
# There is no API server there, so requests are answered in the browser.
VITE_DATA_MODE=browser
VITE_MAPS_PROVIDER=osm
VITE_BASE_PATH=/smart-trip-planner/

# Once the API is hosted, remove VITE_DATA_MODE and point the site at it instead:
# VITE_API_URL=https://<api-host>/api/v1
