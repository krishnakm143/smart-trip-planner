@startuml architecture
!include _style.iuml
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 55

node "Presentation tier\nWeb browser - React 18 SPA (Vite, React Router)" as B {
  component "Pages\nHome, Destinations,\nDestination Details, Plan Trip,\nMy Trips, Trip Details,\nLogin, Register" as Pages
  component "AuthContext +\nProtectedRoute\n(JWT in localStorage)" as Ctx
  component "services/apiClient.js\nfetch wrapper, Bearer token,\nenvelope unwrap, ApiError" as Api
}

node "Application tier\nNode.js + Express REST API (/api/v1, port 4100)" as S {
  component "Middleware\nhelmet, cors, rate limit,\nJWT auth, Zod validate,\nerrorHandler" as MW
  component "Routes + Controllers\nauth, destinations, planner,\nbudget, trips, health" as Ctrl
  component "Services\nauth, destination, itinerary,\nbudget, trip" as Svc
  component "Provider adapters\nRouteProvider / PlacesProvider\nOSM or Google (4 s timeout)\nwith fallback to Local" as Prov
  component "Mongoose models\nUser, Destination,\nActivity, Trip" as Mod
}

database "Data tier - MongoDB 7\ndatabase smart_trip_planner\n\nusers, destinations,\nactivities, trips" as DB

cloud "External map services\n(optional)" as G {
  component "Places: Overpass (OSM)\nor Google Places API" as GPl
  component "Routes: OSRM\nor Google Distance Matrix" as GDM
}

Pages -right-> Ctx : uses
Ctx -right-> Api
Api -down-> MW : HTTP / JSON\nAuthorization: Bearer JWT
MW -right-> Ctrl
Ctrl -right-> Svc
Svc -down-> Mod
Svc -down-> Prov
Prov .left.> Mod : local fallback\nreads activities
Mod -down-> DB : Mongoose\nTCP 27017
Prov -right-> GPl : HTTPS
Prov -right-> GDM : HTTPS
GPl -[hidden]down- GDM
@enduml
