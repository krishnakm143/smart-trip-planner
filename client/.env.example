# Base API URL for backend calls.
# In local development: /api/v1 (proxied via vite.config.js to http://localhost:4100)
# In production (e.g. Render backend): https://smart-trip-planner-api-gpld.onrender.com/api/v1
VITE_API_URL=/api/v1

# Supabase Configuration (PostgreSQL Database & Authentication)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
