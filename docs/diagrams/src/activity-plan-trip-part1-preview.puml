@startuml activity-plan-trip-part1-preview
!include _style.iuml
title Plan Trip - Part 1: Generate plan preview
|Traveller|
start
:Choose destination and open Plan Trip
(/plan?destination=slug);
repeat
  :Fill dates, travellers, budget tier,
  interests and pace;
  |React Client|
  :Validate form;
  backward :Show field errors;
repeat while (Input valid?) is (no) not (yes)
:POST /planner/preview (PlanInput);
|Express API|
:Validate PlanInput (Zod): endDate >= startDate,
days <= 14, startDate not in past;
if (Valid?) then (no)
  :400 VALIDATION_ERROR + details,
  client shows error state (retry);
  stop
else (yes)
endif
|MongoDB / Providers|
:Load destination and
its activities;
|Express API|
:Score activities (rating + 1.5 if interest match),
hoursPerDay from pace (6 / 8 / 10);
repeat
  :Seed day with highest-scored
  unassigned activity;
  |MongoDB / Providers|
  :RouteProvider.getLeg(from, to):
  OSRM / Google Distance Matrix, or
  local haversine fallback;
  |Express API|
  :Add nearest activities while visit + travel
  hours fit; morning first, evening last;
repeat while (More days?) is (yes) not (no)
:Schedule each day from 09:00
(+ travel time, 60-min lunch gap);
:Estimate budget
(stay, food, transport, activities);
:200 { destination, days, itinerary,
budget }, meta.provider;
|React Client|
:Show plan preview
(itinerary + budget breakdown);
|Traveller|
:Review preview
(continue with Part 2: Save trip);
stop
@enduml
